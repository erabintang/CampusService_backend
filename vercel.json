{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/storage/(.*)", "dest": "/public/storage/$1" },
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist",
  "installCommand": "composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist"
}
