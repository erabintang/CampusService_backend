# Caddyfile — FrankenPHP untuk CampusService (Laravel 12)
#
# Cara menjalankan (dari root project):
#   tools/frankenphp/frankenphp.exe run
#
# Fallback tetap tersedia:
#   php artisan serve
#
# Melayani di http://127.0.0.1:8000 dan http://localhost:8000.
# Kedua host dilayani agar cookie session Laravel (SameSite=Lax) selalu
# same-site terhadap halaman Next.js: halaman di localhost:3000 memanggil
# API di localhost:8000, halaman di 127.0.0.1:3000 memanggil 127.0.0.1:8000.
# Tanpa ini, host localhost mendapat respons kosong (tidak di-route ke PHP).

{
	frankenphp
	auto_https off
}

http://127.0.0.1:8000, http://localhost:8000 {
	# Webroot Laravel
	root * public

	# Kompresi (opsional)
	encode zstd gzip

	# Jalankan PHP dari public/ dan layani aset statis
	php_server
}
